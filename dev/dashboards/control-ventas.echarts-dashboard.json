{
  "format": "dbeaver-echarts-dashboard",
  "schemaVersion": 1,
  "title": "Control de ventas y mapa de ciudades",
  "renderer": "canvas",
  "variables": {},
  "filters": {},
  "widgets": [
    {
      "id": "ventas-diarias-linea",
      "title": "Ventas y costos diarios",
      "source": {
        "schemaVersion": 1,
        "kind": "savedQuery",
        "name": "Ventas diarias",
        "connection": "test_hop_mcp",
        "connectionId": null,
        "project": "General",
        "sql": "SELECT fecha, ROUND(SUM(ventas),2) AS ventas, ROUND(SUM(costos),2) AS costos\nFROM echarts_test_sales\nGROUP BY fecha ORDER BY fecha;"
      },
      "chart": {
        "chartType": "line",
        "xColumn": "fecha",
        "yColumns": ["ventas", "costos"],
        "yAxes": {"ventas": "left", "costos": "right"},
        "marks": {}
      },
      "refreshPolicy": {"mode": "manual", "intervalSeconds": 0},
      "drillDown": {"enabled": true},
      "layout": {"columnSpan": 1, "rowSpan": 1}
    },
    {
      "id": "ventas-diarias-barras",
      "title": "Comparación diaria",
      "source": {
        "schemaVersion": 1,
        "kind": "savedQuery",
        "name": "Ventas diarias",
        "connection": "test_hop_mcp",
        "connectionId": null,
        "project": "General",
        "sql": "SELECT fecha, ROUND(SUM(ventas),2) AS ventas, ROUND(SUM(costos),2) AS costos\nFROM echarts_test_sales\nGROUP BY fecha ORDER BY fecha;"
      },
      "chart": {
        "chartType": "bar",
        "xColumn": "fecha",
        "yColumns": ["ventas", "costos"],
        "yAxes": {"ventas": "left", "costos": "right"},
        "marks": {}
      },
      "refreshPolicy": {"mode": "manual", "intervalSeconds": 0},
      "drillDown": {"enabled": true},
      "layout": {"columnSpan": 1, "rowSpan": 1}
    },
    {
      "id": "ventas-ciudades-mapa",
      "title": "Ventas por ciudad",
      "source": {
        "schemaVersion": 1,
        "kind": "savedQuery",
        "name": "Ciudades de Ecuador",
        "connection": "test_hop_mcp",
        "connectionId": null,
        "project": "General",
        "sql": "SELECT ciudad, longitud, latitud, ROUND(SUM(ventas),2) AS ventas\nFROM echarts_test_sales\nGROUP BY ciudad, longitud, latitud ORDER BY ventas DESC;"
      },
      "chart": {
        "chartType": "map",
        "xColumn": "longitud",
        "yColumns": ["latitud", "ventas"],
        "yAxes": {},
        "marks": {}
      },
      "refreshPolicy": {"mode": "manual", "intervalSeconds": 0},
      "drillDown": {"enabled": true},
      "layout": {"columnSpan": 2, "rowSpan": 1}
    }
  ]
}
