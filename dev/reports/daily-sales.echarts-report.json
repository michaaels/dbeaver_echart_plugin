      "id": "daily-sales",
      "name": "Ventas diarias",
      "kind": "savedQuery",
      "project": "",
      "connection": "",
      "connectionId": "",
      "sql": "SELECT fecha, ROUND(SUM(ventas),2) AS ventas, ROUND(SUM(costos),2) AS costos\nFROM echarts_test_sales\nWHERE fecha >= :start_date\nGROUP BY fecha ORDER BY fecha;",
